{
  "name": "gea-opengameconsole",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "gea dev",
    "build": "gea build --target web",
    "check": "tsc --noEmit",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "rom": "node scripts/nes/write-pad-demo.mjs"
  },
  "dependencies": {
    "@geajs/core": "^1.3.0",
    "@geastack/core": "^0.1.34",
    "@geastack/cli": "^0.1.95",
    "@geastack/linux": "file:vendor/geastack-linux"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "latest"
  },
  "gea": {
    "id": "opengameconsole",
    "name": "Opengameconsole",
    "entry": "src/index.tsx",
    "compilerPlugins": ["scripts/nes-host-plugin.mjs"],
    "targets": {
      "web": true,
      "esp32": false,
      "rp2350": false,
      "geaos": false,
      "macos": false,
      "ios": false,
      "android": false,
      "windows": false
    }
  },
  "license": "MIT"
}
